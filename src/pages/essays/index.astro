---
export const prerender = true;
import MinimalDarkLayout from "@/layouts/MinimalDarkLayout.astro";
import { getCollection } from "astro:content";
import { readingMinutesForEssayId } from "@/lib/essay-reading";

const essays = (await getCollection("essays")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<MinimalDarkLayout title="Essays · Ara">
  <div
    class="mx-auto max-w-3xl px-6 pb-24 pt-12 text-left md:px-8 md:pt-16"
  >
    <p
      class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-600 dark:text-neutral-500"
    >
      Essays
    </p>
    <h1
      class="mt-3 text-3xl font-normal leading-tight text-neutral-900 md:text-4xl md:leading-tight dark:text-white"
    >
      Notes on software, ownership, and the open web
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
      Longer-form writing from the Ara project. These replace the older database-backed
      blog; new pieces ship here as static essays.
    </p>
    <ul class="mt-12 space-y-10 border-t border-neutral-200 pt-10 dark:border-white/10">
      {
        essays.map((essay) => (
          <li>
            <a
              href={`/essays/${essay.id}`}
              class="group block rounded-lg outline-none transition-colors focus-visible:ring-2 focus-visible:ring-neutral-400 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-50 dark:focus-visible:ring-neutral-500 dark:focus-visible:ring-offset-black"
            >
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-500">
                <time datetime={essay.data.pubDate.toISOString()}>
                  {essay.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span aria-hidden="true"> · </span>
                <span>{readingMinutesForEssayId(essay.id)} min read</span>
              </p>
              <h2 class="mt-2 text-xl font-normal text-neutral-900 group-hover:text-neutral-600 dark:text-white dark:group-hover:text-neutral-300">
                {essay.data.title}
              </h2>
              <p class="mt-2 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
                {essay.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</MinimalDarkLayout>
