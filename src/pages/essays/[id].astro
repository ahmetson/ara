---
export const prerender = true;
import MinimalDarkLayout from "@/layouts/MinimalDarkLayout.astro";
import { getCollection, render } from "astro:content";
import EssayFooter from "@/components/essays/EssayFooter";
import { readingMinutesForEssayId } from "@/lib/essay-reading";

export async function getStaticPaths() {
  const essays = await getCollection("essays");
  return essays.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readingMinutes = readingMinutesForEssayId(entry.id);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<MinimalDarkLayout title={`${entry.data.title} · Essays · Ara`}>
  <article
    class="essay-article mx-auto max-w-3xl px-6 pb-24 pt-12 text-left md:px-8 md:pt-16"
  >
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-600 dark:text-neutral-500">
      <a
        href="/essays"
        class="underline decoration-neutral-400 underline-offset-4 transition-colors hover:text-neutral-900 dark:decoration-white/25 dark:hover:text-white"
      >Essays</a>
    </p>
    <h1
      class="mt-4 text-3xl font-normal leading-tight text-neutral-900 md:text-4xl md:leading-tight dark:text-white"
    >
      {entry.data.title}
    </h1>
    <p class="mt-3 max-w-2xl text-neutral-600 dark:text-neutral-400">
      {entry.data.description}
    </p>
    <div
      class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500 dark:text-neutral-500"
    >
      <time datetime={entry.data.pubDate.toISOString()}>
        {formattedDate}
      </time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes} min read</span>
      <span aria-hidden="true">·</span>
      <span>
        By{" "}
        <a
          href="/about"
          class="text-neutral-700 underline decoration-neutral-400 underline-offset-4 transition-colors hover:text-neutral-900 dark:text-neutral-300 dark:decoration-white/25 dark:hover:text-white"
        >Medet Ahmetson</a>
      </span>
    </div>
    <div
      class="essay-body mt-12 space-y-4 border-t border-neutral-200 pt-10 text-base leading-relaxed text-neutral-700 dark:border-white/10 dark:text-neutral-300"
    >
      <Content />
    </div>

    <EssayFooter
      client:load
      essayId={entry.id}
      title={entry.data.title}
      shareUrl={canonicalUrl}
    />

    <div
      class="mt-12 border-t border-neutral-200 pt-8 text-sm text-neutral-500 dark:border-white/10 dark:text-neutral-500"
    >
      <p>
        <a
          href="/essays"
          class="underline decoration-neutral-400 underline-offset-4 transition-colors hover:text-neutral-900 dark:hover:text-neutral-200"
        >← All essays</a>
      </p>
    </div>
  </article>
</MinimalDarkLayout>

<style is:global>
  .essay-body p {
    margin: 0;
  }

  .essay-body p + p {
    margin-top: 1.25rem;
  }

  .essay-body strong {
    font-weight: 600;
  }

  .essay-body em {
    font-style: italic;
  }

  .essay-body blockquote {
    margin: 1.25rem 0 0;
    padding: 0.15rem 0 0.15rem 1.25rem;
    border-left: 3px solid rgb(212 212 212);
    color: rgb(82 82 82);
  }

  .dark .essay-body blockquote {
    border-left-color: rgba(255, 255, 255, 0.18);
    color: rgb(163 163 163);
  }

  .essay-body blockquote p {
    margin: 0;
  }

  .essay-body blockquote p + p {
    margin-top: 0.75rem;
  }

  .essay-body .essay-figure {
    margin: 1.25rem 0 0;
  }

  .essay-body .essay-figure img {
    display: block;
    max-width: min(100%, 28rem);
    height: auto;
    border-radius: 0.375rem;
    border: 1px solid rgb(229 229 229);
  }

  .dark .essay-body .essay-figure img {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .essay-body .essay-figure figcaption {
    margin-top: 0.45rem;
    font-size: 0.75rem;
    line-height: 1.35;
    color: rgb(115 115 115);
  }

  .dark .essay-body .essay-figure figcaption {
    color: rgb(115 115 115);
  }

  .essay-body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Tailwind preflight strips list markers; restore for essay content */
  .essay-body ul {
    margin: 1rem 0 0;
    padding-left: 1.5rem;
    list-style-type: disc;
    list-style-position: outside;
  }

  .essay-body ol {
    margin: 1rem 0 0;
    padding-left: 1.5rem;
    list-style-type: decimal;
    list-style-position: outside;
  }

  .essay-body ul ul {
    list-style-type: circle;
    margin-top: 0.35rem;
  }

  .essay-body li {
    margin-top: 0.35rem;
    padding-left: 0.35rem;
  }

  .essay-body li::marker {
    color: rgb(115 115 115);
  }

  .dark .essay-body li::marker {
    color: rgb(163 163 163);
  }

  .essay-body h2 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--tw-prose-headings, inherit);
  }

  .essay-body h2:first-child {
    margin-top: 0;
  }

  /* h3/h4: Markdown ### renders as <h3>; Tailwind preflight removes heading styling */
  .essay-body h3 {
    margin: 1.75rem 0 0.6rem;
    font-family: "Merriweather", Georgia, "Times New Roman", serif;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: rgb(23 23 23);
  }

  .essay-body h2 + h3 {
    margin-top: 1.25rem;
  }

  .essay-body h3 + p {
    margin-top: 0;
  }

  .dark .essay-body h3 {
    color: rgb(245 245 245);
  }

  .essay-body h4 {
    margin: 1.25rem 0 0.5rem;
    font-family: "Merriweather", Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: rgb(38 38 38);
  }

  .dark .essay-body h4 {
    color: rgb(229 229 229);
  }

  /* Step markers (1/5 … 5/5): float left beside the clause that follows */
  .essay-body .essay-para-step {
    display: flow-root;
    position: relative;
  }

  .essay-body .essay-step-float {
    float: left;
    margin: 0.15rem 0.75rem 0.4rem 0;
    line-height: 1;
  }

  .essay-body .essay-step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.35rem;
    padding: 0.28rem 0.45rem;
    font-family: ui-monospace, "DM Mono", monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgb(64 64 64);
    border-radius: 9999px;
    border: 1px solid rgb(229 229 229);
    background: rgb(250 250 250);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
  }

  .dark .essay-body .essay-step-badge {
    color: rgb(212 212 212);
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: none;
  }

  .essay-body .essay-step-rest {
    display: block;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .essay-body .essay-step-float {
      float: none;
      display: inline-flex;
      vertical-align: middle;
      margin: 0 0.35rem 0.35rem 0;
    }

    .essay-body .essay-step-rest {
      display: inline;
      overflow: visible;
    }
  }

  /* Subscribe line: LinkedIn, X, Bluesky (same URLs as header) */
  .essay-body .essay-inline-social {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0.2rem;
    vertical-align: middle;
  }

  .essay-body .essay-soc-icon {
    display: inline-flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid rgb(229 229 229);
    background: rgb(250 250 250);
    color: rgb(82 82 82);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .essay-body .essay-soc-icon:hover {
    border-color: rgb(212 212 212);
    background: rgb(245 245 245);
    color: rgb(23 23 23);
  }

  .essay-body .essay-soc-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .dark .essay-body .essay-soc-icon {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: rgb(163 163 163);
  }

  .dark .essay-body .essay-soc-icon:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: rgb(245 245 245);
  }
</style>
